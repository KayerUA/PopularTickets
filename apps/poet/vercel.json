{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "popularpoet.pl" }],
      "destination": "https://www.popularpoet.pl/ru",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "popularpoet.pl" }],
      "destination": "https://www.popularpoet.pl/:path*",
      "permanent": true
    }
  ]
}
